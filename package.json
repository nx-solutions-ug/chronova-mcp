{
  "name": "@chronova/mcp-server",
  "version": "1.11.2",
  "private": false,
  "keywords": [],
  "homepage": "https://github.com/nx-solutions-ug/chronova-mcp#readme",
  "bugs": {
    "url": "https://github.com/nx-solutions-ug/chronova-mcp/issues"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nx-solutions-ug/chronova-mcp.git"
  },
  "bin": {
    "chronova-mcp-server": "./dist/stdio.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/index.ts src/stdio.ts --outdir dist --target node --format esm --packages external --sourcemap=linked && tsc --emitDeclarationOnly",
    "prepublishOnly": "bun run build",
    "start": "bun dist/index.js",
    "dev": "bun --watch src/index.ts",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "oxlint --react-plugin --vitest-plugin --import-plugin",
    "lint:fix": "oxlint --react-plugin --vitest-plugin --import-plugin --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "semantic-release": "semantic-release",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.0",
    "@semantic-release/github": "^12.0.0",
    "@semantic-release/npm": "^13.0.0",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.0",
    "@types/supertest": "^7.2.0",
    "husky": "^9.1.7",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "semantic-release": "^25.0.0",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "bun": ">=1.2",
    "node": ">=18"
  },
  "packageManager": "bun@1.4.2"
}
